{
  "name": "tutelliv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-dev.mjs && next dev --turbopack",
    "dev:fast": "next dev",
    "dev:turbo": "node scripts/ensure-dev.mjs && next dev --turbopack",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev",
    "build": "node scripts/ensure-build.mjs && next build",
    "build:clean": "rm -rf .next node_modules/.cache && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:sync-schema": "dotenv -e .env.local -- tsx scripts/db-sync-schema.ts",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:seed-test-accounts": "dotenv -e .env.local -- tsx scripts/seed-test-accounts.ts",
    "db:seed-random-orders": "dotenv -e .env.local -- tsx scripts/seed-random-orders.ts",
    "db:seed-demo": "dotenv -e .env.local -- tsx scripts/seed-demo-environment.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "^15.5.19",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.22.4"
  }
}
