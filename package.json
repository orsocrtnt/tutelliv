{
  "name": "tutelliv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "node scripts/ensure-dev.mjs && next dev --turbopack",
    "dev:fast": "next dev",
    "dev:turbo": "node scripts/ensure-dev.mjs && next dev --turbopack",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev",
    "build": "node scripts/ensure-build.mjs && next build",
    "build:clean": "rm -rf .next node_modules/.cache && next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:sync-schema": "dotenv -e .env.local -- tsx scripts/db-sync-schema.ts",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:seed-test-accounts": "dotenv -e .env.local -- tsx scripts/seed-test-accounts.ts",
    "platform:create-owner": "dotenv -e .env.preproduction.local -- tsx scripts/platform/create-owner.ts",
    "db:seed-random-orders": "dotenv -e .env.local -- tsx scripts/seed-random-orders.ts",
    "db:seed-demo": "dotenv -e .env.local -- tsx scripts/seed-demo-environment.ts",
    "db:seed-offer-environments": "dotenv -e .env.preproduction.local -- tsx scripts/seed-offer-environments.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/maps/copy-maplibre-worker.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:connected": "dotenv -e .env.local -- tsx scripts/test-v1/connected.ts outputs/test2/connected.json",
    "test:e2e": "playwright test",
    "test:v1:browser-fixture:setup": "tsx scripts/test-v1/setup-browser-fixture.ts",
    "test:v1:browser-fixture:cleanup": "tsx scripts/test-v1/cleanup-browser-fixture.ts",
    "test:v1": "npm test && npm run test:connected && npm run test:e2e && node scripts/test-v1/verify-output.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:support1": "dotenv -e .env.local -- tsx scripts/support1/connected.ts outputs/support1/connected.json",
    "test:support1:e2e": "playwright test tests/e2e/support.spec.ts",
    "test:onboard1": "dotenv -e .env.preproduction.local -- tsx scripts/onboard1/connected.ts outputs/onboard1/connected.json",
    "test:onboard1:e2e": "dotenv -e .env.preproduction.local -- playwright test tests/e2e/onboarding.spec.ts",
    "test:ops01": "dotenv -e .env.local -- tsx scripts/ops01/connected.ts outputs/ops01/connected.json",
    "test:special1": "dotenv -e .env.local -- tsx scripts/special1/connected.ts outputs/special1/connected.json",
    "test:demo1": "dotenv -e .env.local -- tsx scripts/demo1/connected.ts outputs/demo1/connected.json",
    "demo2:prepare": "dotenv -e .env.preproduction.local -- tsx scripts/demo2/prepare-pool.ts",
    "demo2:maintain": "dotenv -e .env.preproduction.local -- tsx scripts/demo2/maintain-pool.ts",
    "test:demo2": "dotenv -e .env.preproduction.local -- tsx scripts/demo2/connected.ts outputs/demo2/connected.json",
    "mob01c:setup": "dotenv -e .env.preproduction.local -- tsx scripts/mob01c/field-fixture.ts setup",
    "mob01c:watch": "caffeinate -i dotenv -e .env.preproduction.local -- tsx scripts/mob01c/field-fixture.ts watch",
    "mob01c:cleanup": "dotenv -e .env.preproduction.local -- tsx scripts/mob01c/field-fixture.ts cleanup",
    "test:demo2:http": "dotenv -e .env.preproduction.local -- tsx scripts/demo2/http-benchmark.ts outputs/demo2/http.json",
    "test:signup1": "dotenv -e .env.preproduction.local -- tsx scripts/signup1/connected.ts outputs/signup1/connected.json",
    "test:saas01b": "tsx scripts/saas01b/run-local.ts outputs/saas01b/local-connected.json",
    "test:saas01b:e2e": "playwright test tests/e2e/billing.spec.ts",
    "test:perf02": "tsx scripts/perf02/run-local.ts outputs/perf02/local.json",
    "test:perf02:postgres": "tsx scripts/perf02/postgres-local.ts outputs/perf02/postgres-local.json",
    "test:perf02:next": "tsx scripts/perf02/next-local.ts outputs/perf02/next-local.json",
    "recette:email-real": "dotenv -e .env.local -- tsx scripts/email/real-recette.ts",
    "recette:sec05-real": "dotenv -e .env.local -- tsx scripts/email/sec05-real.ts",
    "test:perf02:preprod": "tsx scripts/perf02/preprod-public.ts https://tutelliv.fr/ outputs/perf02/preprod-public.json",
    "test:perf02:preprod-connected": "tsx scripts/perf02/preprod-connected.ts https://tutelliv.fr/ outputs/perf02/preprod-connected.json",
    "test:perf02:connected": "dotenv -e .env.local -- tsx scripts/perf02/next-connected.ts outputs/perf02/next-connected.json",
    "test:email-sec05": "node --import tsx --test tests/password-link.test.ts tests/transactional-email.test.ts tests/email-template.test.ts tests/notification-idempotency.test.ts tests/operation-jobs.test.ts",
    "test:saas03": "node --import tsx --test tests/saas03-subscription.test.ts tests/saas03-plan-change.test.ts tests/saas03-payment-portal.test.ts tests/saas03-options.test.ts",
    "test:saas03:e2e": "playwright test tests/e2e/saas03.spec.ts",
    "test:saas04": "node --import tsx --test tests/saas04-premium-discovery.test.ts",
    "test:growth01": "node --import tsx --test tests/growth01-public-pricing.test.ts tests/growth01-features.test.ts tests/growth01-demo.test.ts tests/growth01-public-journey.test.ts",
    "test:sales01": "node --import tsx --test tests/sales01-commission.test.ts tests/sales01-codes.test.ts tests/sales01-admin-routes.test.ts tests/sales01-ledger.test.ts",
    "test:saas02": "node --import tsx --test tests/saas02-health.test.ts tests/saas02-reconciliation.test.ts",
    "saas02:reconcile": "dotenv -e .env.local -- tsx scripts/saas02/reconcile.ts",
    "test:admin01": "node --import tsx --test tests/admin01-subscriptions.test.ts tests/admin01-support.test.ts tests/admin01-operation-jobs.test.ts tests/admin01-incidents.test.ts tests/admin01-service-health.test.ts tests/admin01-companies.test.ts tests/admin01-user-mutation-boundary.test.ts tests/admin01-platform-settings-boundary.test.ts tests/admin01-users-list.test.ts tests/admin01-platform-route-boundary.test.ts tests/admin01-back-office-api-boundary.test.ts tests/admin01-dispatch-read-boundary.test.ts tests/admin01-dispatch-mutation-boundary.test.ts tests/admin01-dispatch-settings-boundary.test.ts tests/admin01-company-config-boundary.test.ts tests/admin01-order-read-boundary.test.ts tests/admin01-order-mutation-boundary.test.ts tests/admin01-client-read-boundary.test.ts tests/admin01-driver-read-boundary.test.ts tests/admin01-delivery-read-boundary.test.ts tests/admin01-delivery-mutation-boundary.test.ts tests/admin01-company-operation-jobs-boundary.test.ts tests/admin01-invoice-boundary.test.ts tests/admin01-company-support-boundary.test.ts tests/admin01-conversation-boundary.test.ts tests/admin01-overview-minimization.test.ts tests/admin01-saas-health-isolation.test.ts tests/admin01-platform-api-role.test.ts tests/admin01-platform-route-inventory.test.ts tests/admin01-onboarding-boundary.test.ts tests/admin01-tenant-api-boundary-inventory.test.ts tests/admin01-indirect-company-boundaries.test.ts tests/admin01-no-impersonation.test.ts tests/admin01-company-billing-boundary.test.ts tests/admin01-support-page.test.ts tests/admin01-operation-jobs-page.test.ts tests/admin01-access-audit.test.ts tests/admin01-access-events-page.test.ts tests/admin01-company-detail.test.ts tests/admin01-acceptance-gate.test.ts",
    "cost1:model": "node scripts/cost1/model.mjs outputs/cost1/model.json",
    "cost1:perf02": "node scripts/cost1/perf02-local.mjs outputs/perf02/local.json outputs/cost1/model.json outputs/cost1/perf02-local-validation.json",
    "test:ops03b": "dotenv -e .env.local -- tsx scripts/ops03b/connected.ts outputs/ops03b/connected.json",
    "ops03b:rehearse-preproduction": "dotenv -e .env.preproduction.local -e .env.ops03b.local -- tsx scripts/ops03b/rehearse-preproduction.ts outputs/ops03b/preproduction-rehearsal.json",
    "ops03b:test-channel": "dotenv -e .env.preproduction.local -e .env.ops03b.local -- tsx scripts/ops03b/rehearse-preproduction.ts outputs/ops03b/test-channel.json --alert-only",
    "test:data02": "dotenv -e .env.local -- tsx scripts/data02/connected.ts outputs/data02/connected.json",
    "test:data02:inventory": "node --import tsx --test tests/data02-inventory.test.ts",
    "test:data02:export-contract": "node --import tsx --test tests/data02-export-contract.test.ts",
    "test:data02:demo-retention": "dotenv -e .env.local -- tsx scripts/data02/demo-retention-connected.ts",
    "data02:demo-cleanup": "dotenv -e .env.local -- tsx scripts/data02/cleanup-demo.ts",
    "data02:company-erasure": "dotenv -e .env.local -- tsx scripts/data02/erase-company.ts",
    "test:data02:erasure": "dotenv -e .env.local -- tsx scripts/data02/erasure-connected.ts outputs/data02/erasure-connected.json",
    "e2e:test-data": "dotenv -e .env.local -- tsx scripts/e2e/dev-test-data.ts",
    "push:setup-keys": "node scripts/driver-push/setup-vapid-keys.mjs",
    "e2e:role-accounts": "dotenv -e .env.local -- tsx scripts/e2e/dev-role-accounts.ts",
    "data02:demo-legacy-inventory": "dotenv -e .env.local -- tsx scripts/data02/inventory-legacy-demos.ts",
    "audit:env1": "dotenv -e .env.local -- tsx scripts/env1/inventory.ts outputs/env1/inventory.json",
    "audit:db1": "dotenv -e .env.local -- tsx scripts/db1/inventory.ts outputs/db1/inventory.json outputs/db1/prisma-baseline-draft.sql outputs/db1/security-baseline-draft.sql",
    "db1:verify-preproduction": "tsx scripts/db1/verify-preproduction.ts outputs/db1/preproduction-validation.json",
    "db1:rehearse-preproduction": "dotenv -e .env.preproduction.local -- tsx scripts/db1/rehearse-migration-restore.ts outputs/db1/migration-restore-rehearsal.json",
    "audit:ops03a": "dotenv -e .env.local -- tsx scripts/ops03a/inventory.ts outputs/ops03a/inventory.json",
    "ops03a:rehearse-preproduction": "dotenv -e .env.preproduction.local -- tsx scripts/ops03a/rehearse-backup-restore.ts outputs/ops03a/restore-rehearsal.json",
    "ops03a:restore-provider-storage": "dotenv -e .env.ops03a-storage.local -- tsx scripts/ops03a/restore-provider-storage.ts",
    "ci:secrets": "node scripts/ci/scan-secrets.mjs",
    "ci:preprod-env": "tsx scripts/ci/verify-preproduction-env.ts",
    "todo:progress": "node scripts/docs/update-todo-progress.mjs",
    "docs:verify": "npm run todo:progress && node scripts/docs/verify-docs.mjs outputs/doc1/verification.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:pg-locks": "tsx scripts/pg-locks/advisory-locks.ts",
    "test:pg-settings": "tsx scripts/pg-locks/settings-claims.ts",
    "test:pg-intake": "tsx scripts/pg-locks/order-intake.ts",
    "test:dispatch-concurrency": "tsx scripts/dispatch4/concurrent-assign.ts",
    "env2:verify-dev": "dotenv -e .env.local -- tsx scripts/env2/verify-dev-env.ts",
    "billing:refund": "dotenv -e .env.local -- tsx scripts/saas01b/refund.ts"
  },
